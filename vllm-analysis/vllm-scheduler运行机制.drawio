    <mxCell id="feature1" value="✓ Unified Scheduling&#xa;No separate prefill/decode phases&#xa;Uses num_tokens_with_spec" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;" vertex="1" parent="features">
