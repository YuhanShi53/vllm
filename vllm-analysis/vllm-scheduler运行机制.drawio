    <!-- Title -->
    <mxCell id="title" value="vLLM V1 Scheduler: Detailed Internal Mechanism" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1" vertex="1" parent="1">
      <mxGeometry x="400" y="20" width="1000" height="40" as="geometry" />
    </mxCell>

    <!-- Main Scheduler Container -->
    <mxCell id="scheduler_container" value="Scheduler.schedule() - Main Scheduling Loop" style="swimlane;fontSize=14;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
      <mxGeometry x="60" y="80" width="1680" height="1250" as="geometry" />
    </mxCell>

    <!-- Phase 1: Schedule Running Requests -->
    <mxCell id="phase1" value="PHASE 1: Schedule Running Requests" style="swimlane;fontSize=12;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="scheduler_container">
      <mxGeometry x="40" y="50" width="760" height="520" as="geometry" />
    </mxCell>

    <mxCell id="running_reqs" value="Get Running Requests&#xa;requests = self.running" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="phase1">
      <mxGeometry x="40" y="50" width="180" height="50" as="geometry" />
    </mxCell>

    <mxCell id="calc_tokens" value="Calculate New Tokens&#xa;num_new_tokens = (&#xa;  request.num_tokens_with_spec&#xa;  + request.num_output_placeholders&#xa;  - request.num_computed_tokens&#xa;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;" vertex="1" parent="phase1">
      <mxGeometry x="280" y="40" width="240" height="70" as="geometry" />
    </mxCell>

    <mxCell id="check_completion" value="Check Completion&#xa;check_stop(request)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="phase1">
      <mxGeometry x="40" y="140" width="180" height="50" as="geometry" />
    </mxCell>

    <mxCell id="allocate_kv" value="Allocate KV Cache&#xa;allocate_blocks(&#xa;  request, num_new_tokens&#xa;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;" vertex="1" parent="phase1">
      <mxGeometry x="40" y="230" width="180" height="60" as="geometry" />
    </mxCell>

    <mxCell id="alloc_fail" value="Allocation Failed?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="phase1">
      <mxGeometry x="60" y="330" width="140" height="80" as="geometry" />
    </mxCell>

    <mxCell id="preempt" value="Preempt Request&#xa;1. Free request's KV blocks&#xa;2. Free encoder cache&#xa;3. Move to waiting queue&#xa;4. Set status=PREEMPTED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;" vertex="1" parent="phase1">
      <mxGeometry x="40" y="440" width="200" height="60" as="geometry" />
    </mxCell>

    <mxCell id="add_to_scheduled" value="Add to Scheduled&#xa;scheduled_reqs.append(request)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="phase1">
      <mxGeometry x="320" y="230" width="180" height="50" as="geometry" />
    </mxCell>

    <mxCell id="spec_decode" value="Handle Speculative Decode&#xa;scheduled_spec_tokens[&#xa;  request_id] = (&#xa;  request.spec_token_ids&#xa;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;" vertex="1" parent="phase1">
      <mxGeometry x="320" y="320" width="200" height="60" as="geometry" />
    </mxCell>

    <mxCell id="encoder_input" value="Process Encoder Input&#xa;(for multimodal models)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="phase1">
      <mxGeometry x="320" y="410" width="200" height="50" as="geometry" />
    </mxCell>

    <!-- Phase 2: Schedule Waiting Requests -->
    <mxCell id="phase2" value="PHASE 2: Schedule Waiting Requests" style="swimlane;fontSize=12;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="scheduler_container">
      <mxGeometry x="40" y="610" width="760" height="580" as="geometry" />
    </mxCell>

    <mxCell id="get_waiting" value="Get Waiting Requests&#xa;waiting_queue = self.waiting" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="phase2">
      <mxGeometry x="40" y="50" width="180" height="50" as="geometry" />
    </mxCell>

    <mxCell id="check_state" value="Check Request State&#xa;Is WAITING_FOR_REMOTE_KVS?&#xa;Is WAITING_FOR_FSM?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;" vertex="1" parent="phase2">
      <mxGeometry x="40" y="130" width="200" height="60" as="geometry" />
    </mxCell>

    <mxCell id="check_lora" value="Check LoRA Constraints&#xa;Can LoRA adapter be loaded?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="phase2">
      <mxGeometry x="40" y="220" width="200" height="50" as="geometry" />
    </mxCell>

    <mxCell id="prefix_cache" value="Check Prefix Cache&#xa;get_computed_blocks(&#xa;  request.block_hashes&#xa;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;" vertex="1" parent="phase2">
      <mxGeometry x="40" y="300" width="200" height="60" as="geometry" />
    </mxCell>

    <mxCell id="cache_hit" value="Cache Hit!" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="phase2">
      <mxGeometry x="60" y="390" width="120" height="70" as="geometry" />
    </mxCell>

    <mxCell id="use_cached" value="Use Cached Blocks&#xa;num_computed_tokens +=&#xa;  cached_token_count" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;" vertex="1" parent="phase2">
      <mxGeometry x="40" y="490" width="180" height="50" as="geometry" />
    </mxCell>

    <mxCell id="allocate_waiting" value="Allocate New Blocks&#xa;allocate_blocks(&#xa;  request, num_new_tokens&#xa;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;" vertex="1" parent="phase2">
      <mxGeometry x="280" y="130" width="200" height="60" as="geometry" />
    </mxCell>

    <mxCell id="move_to_running" value="Move to Running&#xa;request.status = RUNNING&#xa;self.running.append(request)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;" vertex="1" parent="phase2">
      <mxGeometry x="280" y="220" width="200" height="60" as="geometry" />
    </mxCell>

    <mxCell id="add_scheduled_waiting" value="Add to Scheduled&#xa;scheduled_reqs.append(request)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="phase2">
      <mxGeometry x="280" y="310" width="200" height="50" as="geometry" />
    </mxCell>

    <mxCell id="token_budget" value="Check Token Budget&#xa;total_tokens + new_tokens &lt; budget?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="phase2">
      <mxGeometry x="280" y="390" width="200" height="50" as="geometry" />
    </mxCell>

    <mxCell id="chunked_prefill" value="Enable Chunked Prefill?&#xa;Process large prompts in chunks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="phase2">
      <mxGeometry x="280" y="470" width="200" height="40" as="geometry" />
    </mxCell>

    <!-- Phase 3: KV Cache Management -->
    <mxCell id="phase3" value="PHASE 3: KV Cache Management" style="swimlane;fontSize=12;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="scheduler_container">
      <mxGeometry x="840" y="50" width="400" height="540" as="geometry" />
    </mxCell>

    <mxCell id="kv_layout" value="KV Cache Block Layout&#xa;&#xa;┌─────────────────────────────┐&#xa;│ &lt; computed &gt;                │ ← Already cached&#xa;├─────────────────────────────┤&#xa;│ &lt; new computed &gt;            │ ← This step&#xa;├─────────────────────────────┤&#xa;│ &lt; new &gt;                     │ ← New tokens&#xa;├─────────────────────────────┤&#xa;│ &lt; pre-allocated &gt;           │ ← Future steps&#xa;└─────────────────────────────┘" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=9;align=left;fontFamily=Courier New;" vertex="1" parent="phase3">
      <mxGeometry x="40" y="50" width="320" height="130" as="geometry" />
    </mxCell>

    <mxCell id="block_alloc_steps" value="Block Allocation Steps&#xa;&#xa;1. Remove skipped blocks&#xa;2. Calculate required blocks&#xa;3. Check availability&#xa;4. Touch computed blocks&#xa;5. Allocate new blocks&#xa;6. Cache finalized blocks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;" vertex="1" parent="phase3">
      <mxGeometry x="40" y="200" width="320" height="120" as="geometry" />
    </mxCell>

    <mxCell id="prefix_cache_mech" value="Prefix Caching Mechanism&#xa;&#xa;• Block hashing per request&#xa;• Find longest cache hit&#xa;• Share blocks across requests&#xa;• Lazy eviction on pressure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;" vertex="1" parent="phase3">
      <mxGeometry x="40" y="340" width="320" height="90" as="geometry" />
    </mxCell>

    <mxCell id="cascade_attention" value="Cascade Attention&#xa;&#xa;Calculate common prefix blocks&#xa;for attention optimization" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;" vertex="1" parent="phase3">
      <mxGeometry x="40" y="450" width="320" height="60" as="geometry" />
