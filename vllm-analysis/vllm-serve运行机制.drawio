                <mxCell id="feat3" value="✓ Chunked Prefill: Large prompts processed in chunks for better throughput" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" parent="info_panel" vertex="1">
                    <mxGeometry x="30" y="115" width="460" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="feat4" value="✓ Preemption: Free blocks from low-priority requests when memory full" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" parent="info_panel" vertex="1">
                    <mxGeometry x="30" y="140" width="460" height="20" as="geometry"/>
