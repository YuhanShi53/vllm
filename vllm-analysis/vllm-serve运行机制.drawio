                <mxCell id="sched_run_title" value="Phase 1: Schedule RUNNING" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=1" parent="scheduler_box" vertex="1">
                    <mxGeometry x="20" y="40" width="350" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="sched_run" value="• For each running request&#xa;• Calculate: num_new_tokens = num_tokens_with_spec - num_computed_tokens&#xa;• Check completion (stop tokens, length cap)&#xa;• Allocate KV cache blocks&#xa;• If fail: PREEMPT (free blocks, move to waiting)&#xa;• Handle spec_decode tokens&#xa;• Process encoder inputs (multimodal)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;align=left;" parent="scheduler_box" vertex="1">
                    <mxGeometry x="20" y="65" width="350" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="sched_wait_title" value="Phase 2: Schedule WAITING" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=1" parent="scheduler_box" vertex="1">
                    <mxGeometry x="20" y="170" width="350" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="sched_wait" value="• For each waiting request&#xa;• Check state: WAITING_FOR_FSM? WAITING_FOR_REMOTE_KVS?&#xa;• Check LoRA constraints&#xa;• Check PREFIX CACHE (find longest hash match)&#xa;  • If hit: use cached blocks, skip recomputation&#xa;  • If miss: allocate new blocks&#xa;• Move to running queue&#xa;• Check token budget&#xa;• Enable chunked prefill for large prompts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;align=left;" parent="scheduler_box" vertex="1">
                    <mxGeometry x="20" y="195" width="350" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="kv_title" value="Phase 3: KV Cache Management" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=1" parent="scheduler_box" vertex="1">
                    <mxGeometry x="20" y="330" width="350" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="kv_cache" value="Block Layout:&#xa;[computed] [new_computed] [new] [pre-allocated]&#xa;&#xa;Operations:&#xa;1. Remove skipped blocks 2. Calculate required&#xa;3. Check availability 4. Touch computed&#xa;5. Allocate new 6. Cache finalized blocks&#xa;&#xa;Features: Prefix caching (hash-based), Cascade attention" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;align=left;fontFamily=Courier New;" parent="scheduler_box" vertex="1">
                    <mxGeometry x="20" y="355" width="350" height="125" as="geometry"/>
                </mxCell>
                <mxCell id="sched_output" value="SchedulerOutput&#xa;scheduled_new_reqs: [NewRequestData]&#xa;scheduled_cached_reqs: [req_ids, block_ids, tokens...]&#xa;num_scheduled_tokens: {req_id: count}&#xa;finished_req_ids: set" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;fontStyle=1" parent="scheduler_box" vertex="1">
                    <mxGeometry x="20" y="490" width="350" height="70" as="geometry"/>
