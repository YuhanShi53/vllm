                <mxCell id="feat1" value="✓ Unified Scheduling: No separate prefill/decode, uses num_tokens_with_spec" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" parent="info_panel" vertex="1">
                    <mxGeometry x="30" y="65" width="460" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="feat2" value="✓ Prefix Caching: Hash-based block sharing across requests (zero-overhead)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" parent="info_panel" vertex="1">
                    <mxGeometry x="30" y="90" width="460" height="20" as="geometry"/>
