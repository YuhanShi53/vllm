                <mxCell id="scheduler_box" value="① SCHEDULER.schedule() - Detailed Flow" style="swimlane;fontSize=12;fontStyle=1;fillColor=#f5f5f5;strokeColor=#b85450;dashed=1;" parent="layer2" vertex="1">
                    <mxGeometry x="260" y="30" width="390" height="580" as="geometry"/>
