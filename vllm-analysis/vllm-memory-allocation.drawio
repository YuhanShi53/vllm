<mxfile host="claude-code">
  <diagram name="vLLM Memory Allocation" id="0">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0_dup1"/>
        <mxCell id="1" parent="0"/>
        
        <!-- Title -->
        <mxCell id="title" value="vLLM 显存分配逻辑 (Memory Allocation Flow)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="300" y="20" width="1000" height="40" as="geometry"/>
        </mxCell>
        
        <!-- Layer 1: Engine Core Initialization -->
        <mxCell id="layer1" value="① Engine Core 初始化阶段" style="swimlane;fontSize=14;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
          <mxGeometry x="60" y="80" width="700" height="200" as="geometry"/>
        </mxCell>
        
        <mxCell id="init_engine" value="EngineCore.__init__&#xa;v1/engine/core.py:226" style=" rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1" parent="layer1" vertex="1">
          <mxGeometry x="30" y="40" width="180" height="50" as="geometry"/>
        </mxCell>
        
        <mxCell id="init_kv" value="_initialize_kv_caches()&#xa;创建 KVCacheManager" style=" rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" parent="layer1" vertex="1">
          <mxGeometry x="260" y="40" width="180" height="50" as="geometry"/>
        </mxCell>
        
        <mxCell id="kv_manager" value="KVCacheManager.__init__&#xa;v1/core/kv_cache_manager.py:94" style=" rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1" parent="layer1" vertex="1">
          <mxGeometry x="490" y="40" width="180" height="50" as="geometry"/>
        </mxCell>
        
        <mxCell id="coordinator" value="get_kv_cache_coordinator()&#xa;分配 KV cache 块" style=" rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" parent="layer1" vertex="1">
          <mxGeometry x="260" y="120" width="180" height="40" as="geometry"/>
        </mxCell>
        
        <!-- Layer 2: GPU Worker Initialization -->
        <mxCell id="layer2" value="② GPU Worker 初始化阶段" style="swimlane;fontSize=14;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1">
          <mxGeometry x="60" y="320" width="700" height="280" as="geometry"/>
        </mxCell>
        
        <mxCell id="init_worker" value="GPUWorker.initialize_from_config&#xa;v1/worker/gpu_worker.py:445" style=" rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1" parent="layer2" vertex="1">
          <mxGeometry x="30" y="40" width="200" height="45" as="geometry"/>
        </mxCell>
        
        <mxCell id="init_runner" value="GPUModelRunner.initialize_kv_cache&#xa;v1/worker/gpu_model_runner.py:6046" style=" rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1" parent="layer2" vertex="1">
          <mxGeometry x="30" y="110" width="200" height="45" as="geometry"/>
        </mxCell>
        
        <mxCell id="init_tensors" value="initialize_kv_cache_tensors()&#xa;分配 KV cache 张量" style=" rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" parent="layer2" vertex="1">
          <mxGeometry x="280" y="110" width="200" height="45" as="geometry"/>
        </mxCell>
        
        <mxCell id="allocate_tensors" value="_allocate_kv_cache_tensors()&#xa;torch.zeros(size, int8)" style=" rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1" parent="layer2" vertex="1">
          <mxGeometry x="280" y="180" width="200" height="45" as="geometry"/>
        </mxCell>
        
        <mxCell id="reshape_tensors" value="_reshape_kv_cache_tensors()&#xa;reshape 为所需形状" style=" rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" parent="layer2" vertex="1">
          <mxGeometry x="510" y="110" width="170" height="45" as="geometry"/>
        </mxCell>
        
        <mxCell id="memory_info" value="显存分配信息:&#xa;- 总块数: num_gpu_blocks&#xa;- 块大小: block_size&#xa;- 数据类型: cache_dtype (fp8/int8)&#xa;- 每层: key + value 两个张量" style=" rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=9;align=left;fontFamily=Courier New;" parent="layer2" vertex="1">
          <mxGeometry x="280" y="235" width="400" height="35" as="geometry"/>
        </mxCell>
        
        <!-- Layer 3: Runtime Allocation -->
        <mxCell id="layer3" value="③ 运行时分配阶段 (Runtime Allocation)" style="swimlane;fontSize=14;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
          <mxGeometry x="60" y="640" width="700" height="500" as="geometry"/>
        </mxCell>
        
        <mxCell id="scheduler_alloc" value="Scheduler._schedule_running()&#xa;为运行中的请求分配 KV cache" style=" rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1" parent="layer3" vertex="1">
          <mxGeometry x="30" y="40" width="220" height="45" as="geometry"/>
        </mxCell>
        
        <mxCell id="kv_allocate" value="KVCacheManager.allocate_slots()&#xa;v1/core/kv_cache_manager.py:206" style=" rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1" parent="layer3" vertex="1">
          <mxGeometry x="30" y="110" width="220" height="45" as="geometry"/>
        </mxCell>
        
        <mxCell id="block_layout" value="KV Cache Block 布局:&#xa;&#xa;|&lt;computed&gt; | &lt;new_comp&gt; | &lt;new&gt; | &lt;lookahead&gt; |&#xa;&#xa;- computed: 已计算的 token&#xa;- new_comp: 前缀缓存命中&#xa;- new: 待计算的新 token&#xa;- lookahead: 推测性解码 token" style=" rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;fontFamily=Courier New;" parent="layer3" vertex="1">
          <mxGeometry x="300" y="40" width="360" height="115" as="geometry"/>
        </mxCell>
        
        <mxCell id="alloc_stages" value="分配三阶段:" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=1" parent="layer3" vertex="1">
          <mxGeometry x="30" y="175" width="220" height="20" as="geometry"/>
        </mxCell>
        
        <mxCell id="stage1" value="① 释放不必要的 computed blocks&#xa;   检查是否有足够的空闲 blocks" style=" rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;align=left;" parent="layer3" vertex="1">
          <mxGeometry x="30" y="200" width="220" height="45" as="geometry"/>
        </mxCell>
        
        <mxCell id="stage2" value="② 处理前缀 tokens (computed + new_comp)&#xa;   - 释放滑窗外的 blocks&#xa;   - 为 ext_comp 分配新 blocks" style=" rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;align=left;" parent="layer3" vertex="1">
          <mxGeometry x="30" y="255" width="220" height="50" as="geometry"/>
        </mxCell>
        
        <mxCell id="stage3" value="③ 为待计算 tokens 分配 blocks&#xa;   (new + lookahead)" style=" rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=9;align=left;" parent="layer3" vertex="1">
          <mxGeometry x="30" y="315" width="220" height="40" as="geometry"/>
        </mxCell>
        
        <mxCell id="return_value" value="返回: KVCacheBlocks&#xa;- blocks: tuple[Sequence[KVCacheBlock], ...]&#xa;- 包含所有分配的块 ID" style=" rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;align=left;" parent="layer3" vertex="1">
          <mxGeometry x="30" y="365" width="220" height="50" as="geometry"/>
        </mxCell>
        
        <mxCell id="prefix_cache" value="前缀缓存优化 (Prefix Caching):&#xa;- 计算每个 block 的 hash&#xa;- 查找已有缓存块&#xa;- 复用相同前缀的 KV cache&#xa;- 减少重复计算" style=" rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=9;align=left;" parent="layer3" vertex="1">
          <mxGeometry x="300" y="175" width="360" height="100" as="geometry"/>
        </mxCell>
        
        <mxCell id="memory_mgmt" value="显存管理策略:&#xa;- PagedAttention: 分页管理 KV cache&#xa;- 预分配: 启动时分配所有 blocks&#xa;- 动态调度: 运行时按需分配&#xa;- 抢占机制: 内存不足时抢占低优先级请求" style=" rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=9;align=left;" parent="layer3" vertex="1">
          <mxGeometry x="300" y="295" width="360" height="120" as="geometry"/>
        </mxCell>
        
